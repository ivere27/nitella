# syntax=docker/dockerfile:1

# Combined Nitella image.
#
# Includes the CLI plus Go/Rust daemon binaries and server utilities.

ARG BUILDER_IMAGE=nitella-builder:unstable
FROM --platform=$BUILDPLATFORM ${BUILDER_IMAGE} AS builder
ARG TARGETPLATFORM
ARG TARGETARCH
ARG TARGETVARIANT

WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,id=go-mod-cache,target=/go/pkg/mod \
    go mod download

COPY api ./api
COPY cmd ./cmd
COPY pkg ./pkg
COPY nitellad-rs/Cargo.toml nitellad-rs/Cargo.lock nitellad-rs/build.rs ./nitellad-rs/
COPY nitellad-rs/bench/*.rs ./nitellad-rs/bench/
COPY nitellad-rs/src ./nitellad-rs/src

RUN --mount=type=cache,id=go-build-cache,target=/root/.cache/go-build \
    --mount=type=cache,id=go-mod-cache,target=/go/pkg/mod \
    set -eux; \
    xx-apk add --no-cache xx-c-essentials; \
    mkdir -p /app/bin; \
    CGO_ENABLED=1 xx-go build -ldflags="-s -w" -o /app/bin/nitella ./cmd/nitella; \
    CGO_ENABLED=1 xx-go build -ldflags="-s -w" -o /app/bin/nitellad ./cmd/nitellad; \
    CGO_ENABLED=1 xx-go build -tags release -ldflags="-s -w" -o /app/bin/hub ./cmd/hub; \
    CGO_ENABLED=0 xx-go build -ldflags="-s -w" -o /app/bin/hubctl ./cmd/hubctl; \
    CGO_ENABLED=1 xx-go build -ldflags="-s -w" -o /app/bin/geoip-server ./cmd/geoip-server; \
    CGO_ENABLED=1 xx-go build -ldflags="-s -w" -o /app/bin/geoip ./cmd/geoip; \
    CGO_ENABLED=0 xx-go build -ldflags="-s -w" -o /app/bin/mock ./cmd/mock; \
    xx-verify /app/bin/nitella /app/bin/nitellad /app/bin/hub /app/bin/hubctl /app/bin/geoip-server /app/bin/geoip /app/bin/mock

RUN --mount=type=cache,id=cargo-registry-cache,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git-cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=cargo-target-cache-${TARGETARCH}${TARGETVARIANT},target=/app/nitellad-rs/target \
    set -eux; \
    xx-apk add --no-cache xx-c-essentials; \
    xx-apk add --no-cache sqlite-dev; \
    RUST_TARGET="$(xx-info)"; \
    RUST_TARGET_ENV="$(printf '%s' "$RUST_TARGET" | tr '[:lower:]-' '[:upper:]_')"; \
    RUST_TARGET_CC="$(printf '%s' "$RUST_TARGET" | tr '-' '_')"; \
    xx-cargo --setup-target-triple; \
    export "CARGO_TARGET_${RUST_TARGET_ENV}_LINKER=${RUST_TARGET}-clang"; \
    export "CC_${RUST_TARGET_CC}=${RUST_TARGET}-clang"; \
    export "PKG_CONFIG=${RUST_TARGET}-pkg-config"; \
    export RUSTFLAGS="-C target-feature=-crt-static -C strip=symbols"; \
    cargo build --locked --release --target "$RUST_TARGET" --target-dir /app/nitellad-rs/target --manifest-path nitellad-rs/Cargo.toml --bin nitellad-rs; \
    cp "/app/nitellad-rs/target/${RUST_TARGET}/release/nitellad-rs" /app/bin/nitellad-rs; \
    xx-verify /app/bin/nitellad-rs

FROM alpine:3.19

RUN apk add --no-cache \
    ca-certificates \
    curl \
    libgcc \
    netcat-openbsd \
    sqlite-libs \
    tzdata

WORKDIR /app

COPY --from=builder /app/bin/nitella /usr/local/bin/nitella
COPY --from=builder /app/bin/nitellad /usr/local/bin/nitellad
COPY --from=builder /app/bin/nitellad-rs /usr/local/bin/nitellad-rs
COPY --from=builder /app/bin/hub /usr/local/bin/hub
COPY --from=builder /app/bin/hubctl /usr/local/bin/hubctl
COPY --from=builder /app/bin/geoip-server /usr/local/bin/geoip-server
COPY --from=builder /app/bin/geoip /usr/local/bin/geoip
COPY --from=builder /app/bin/mock /usr/local/bin/mock

RUN mkdir -p /app/data /app/db /app/config /app/data/admin-certs

# Download GeoLite2 databases (see license info in daemon Dockerfiles).
RUN curl -fsSL -o /app/db/GeoLite2-City.mmdb https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-City.mmdb \
    && curl -fsSL -o /app/db/GeoLite2-ASN.mmdb https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-ASN.mmdb

VOLUME ["/app/data", "/app/config"]

ENTRYPOINT ["nitella"]
