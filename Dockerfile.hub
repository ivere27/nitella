# syntax=docker/dockerfile:1

ARG BUILDER_IMAGE=nitella-builder:unstable
FROM ${BUILDER_IMAGE} AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN --mount=type=cache,id=go-mod-cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,id=go-build-cache,target=/root/.cache/go-build \
    --mount=type=cache,id=go-mod-cache,target=/go/pkg/mod \
    CGO_ENABLED=1 go build -tags release -o hub ./cmd/hub

FROM alpine:3.19
RUN apk add --no-cache ca-certificates sqlite netcat-openbsd
WORKDIR /app
COPY --from=builder /app/hub .

# Data directory for persistence
VOLUME /data

EXPOSE 50052 8080

ENTRYPOINT ["./hub"]
CMD ["--port", "50052", "--http-port", "8080", "--db-path", "/data/hub.db", "--auto-cert", "--cert-data-dir", "/data"]
