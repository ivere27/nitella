# syntax=docker/dockerfile:1

# Nitella Proxy Daemon (Rust implementation)
#
# Includes GeoLite2 databases from MaxMind (https://www.maxmind.com)
# License: CC BY-SA 4.0 - Commercial use allowed with attribution
# Database source: https://github.com/P3TERX/GeoLite.mmdb
#
# Build from the repository root:
#   docker build -f Dockerfile.nitellad-rs -t nitellad-rs .

# Build stage
ARG BUILDER_IMAGE=nitella-builder:unstable
FROM --platform=$BUILDPLATFORM ${BUILDER_IMAGE} AS builder
ARG TARGETPLATFORM
ARG TARGETARCH
ARG TARGETVARIANT

WORKDIR /app
ENV PROTOC_INCLUDE=/usr/include

# nitellad-rs/build.rs compiles protobufs from the repo-level api directory.
COPY api ./api
COPY nitellad-rs/Cargo.toml nitellad-rs/Cargo.lock nitellad-rs/build.rs ./nitellad-rs/
COPY nitellad-rs/bench/*.rs ./nitellad-rs/bench/
COPY nitellad-rs/src/lib.rs nitellad-rs/src/main.rs ./nitellad-rs/src/

RUN --mount=type=cache,id=cargo-registry-cache,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git-cache,target=/usr/local/cargo/git \
    cargo fetch --locked --manifest-path nitellad-rs/Cargo.toml

COPY nitellad-rs/src ./nitellad-rs/src

RUN --mount=type=cache,id=cargo-registry-cache,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git-cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=cargo-target-cache-${TARGETARCH}${TARGETVARIANT},target=/app/nitellad-rs/target \
    set -eux; \
    xx-apk add --no-cache xx-c-essentials; \
    xx-apk add --no-cache sqlite-dev; \
    RUST_TARGET="$(xx-info)"; \
    RUST_TARGET_ENV="$(printf '%s' "$RUST_TARGET" | tr '[:lower:]-' '[:upper:]_')"; \
    RUST_TARGET_CC="$(printf '%s' "$RUST_TARGET" | tr '-' '_')"; \
    xx-cargo --setup-target-triple; \
    export "CARGO_TARGET_${RUST_TARGET_ENV}_LINKER=${RUST_TARGET}-clang"; \
    export "CC_${RUST_TARGET_CC}=${RUST_TARGET}-clang"; \
    export "PKG_CONFIG=${RUST_TARGET}-pkg-config"; \
    export RUSTFLAGS="-C target-feature=-crt-static -C strip=symbols"; \
    cargo build --locked --release --target "$RUST_TARGET" --target-dir /app/nitellad-rs/target --manifest-path nitellad-rs/Cargo.toml --bin nitellad-rs; \
    cp "/app/nitellad-rs/target/${RUST_TARGET}/release/nitellad-rs" /app/nitellad-rs-bin; \
    xx-verify /app/nitellad-rs-bin

# Runtime stage
FROM alpine:3.19

RUN apk add --no-cache \
    ca-certificates \
    curl \
    libgcc \
    sqlite-libs \
    tzdata

WORKDIR /app

COPY --from=builder /app/nitellad-rs-bin /app/nitellad-rs

RUN mkdir -p /app/data /app/db /app/config /app/data/admin-certs \
    && ln -s /app/nitellad-rs /app/nitellad

# Download GeoLite2 databases (see license info at top of file).
RUN curl -fsSL -o /app/db/GeoLite2-City.mmdb https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-City.mmdb \
    && curl -fsSL -o /app/db/GeoLite2-ASN.mmdb https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-ASN.mmdb

# Default ports
# 8080: Proxy port (configurable)
# 50051: Admin gRPC API
EXPOSE 8080 50051

# Volume for persistent data and config
VOLUME ["/app/data", "/app/config"]

# Runtime accepts NITELLA_TOKEN when supplied with docker run -e.

ENTRYPOINT ["/app/nitellad"]
CMD ["--listen", ":8080", "--admin-port", "50051", \
     "--db-path", "/app/data/nitella.db", \
     "--stats-db", "/app/data/stats.db", \
     "--admin-data-dir", "/app/data/admin-certs", \
     "--geoip-city", "/app/db/GeoLite2-City.mmdb", \
     "--geoip-isp", "/app/db/GeoLite2-ASN.mmdb", \
     "--geoip-cache", "/app/data/geoip_cache.db"]
